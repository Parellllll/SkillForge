<Application x:Class="SkillForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palet Warna Default (Light Mode) -->
            <SolidColorBrush x:Key="AppBgBrush" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="InnerCardBgBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="BorderBrushColor" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="SidebarBgBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="SidebarCardBrush" Color="#1E293B"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>