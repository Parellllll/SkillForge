<Window x:Class="SkillForge.Views.AddProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Karya Portofolio Baru" 
        Height="480" Width="520" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Tambah Karya Portofolio" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Catat detail tugas besar atau proyek mandiri Anda." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Form Inputs -->
            <StackPanel Grid.Row="1">
                <!-- Judul Proyek -->
                <TextBlock Text="Judul Karya Proyek *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTitle" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12" FontSize="12"/>

                <!-- Mata Kuliah / Asal -->
                <TextBlock Text="Mata Kuliah / Asal Proyek *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCourse" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12" FontSize="12" Text="Pemrograman Berbasis Kerangka Kerja"/>

                <!-- Tingkat Kesulitan -->
                <TextBlock Text="Tingkat Kompleksitas *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbDifficulty" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12" FontSize="12" SelectedIndex="1">
                    <ComboBoxItem Content="1 - Dasar / Pemula"/>
                    <ComboBoxItem Content="2 - Menengah"/>
                    <ComboBoxItem Content="3 - Kompleks / Lanjutan"/>
                </ComboBox>

                <!-- URL GitHub -->
                <TextBlock Text="Tautan Repositori GitHub" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtRepo" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" FontSize="12" Text="https://github.com/"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Batal" Width="90" Height="36" Margin="0,0,10,0" Background="Transparent" 
                        Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrushColor}" 
                        BorderThickness="1" Click="BtnCancel_Click" Cursor="Hand"/>
                <Button Content="Simpan Proyek" Width="130" Height="36" Background="#6366F1" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>